rules_version = '2';

// Minhas Câmeras — who can see and change what.
//
// users/{uid}            the person (name, e-mail, phones for notifications). Only the person.
// sites/{siteId}         a place (Casa, Igreja…). members: { uid: 'admin' | 'viewer' }.
//                        devices: { uid: true } = the computer(s) that record for this place.
// sites/{siteId}/events  alerts written by the place's computer, read by its members.
// invites/{code}         WhatsApp invite link: 1 person, 48 h.
// pairings/{code}        code shown by a new computer, confirmed by an admin in the app.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function site(id) { return get(/databases/$(database)/documents/sites/$(id)).data; }
    function isAdmin(id) { return signedIn() && site(id).members.get(uid(), '') == 'admin'; }
    function isMember(id) { return signedIn() && site(id).members.get(uid(), '') != ''; }
    function isDevice(id) { return signedIn() && site(id).devices.get(uid(), false) == true; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;
      // Computers read the notification addresses of the members of their place.
      allow read: if signedIn() && exists(/databases/$(database)/documents/devices/$(uid()))
        && get(/databases/$(database)/documents/devices/$(uid())).data.members.hasAny([userId]);
    }

    // Copy of the members of the place the computer belongs to (written by admins),
    // so the computer can find the phones to notify.
    match /devices/{deviceId} {
      allow read: if signedIn() && uid() == deviceId;
      allow write: if signedIn() && request.resource.data.siteId is string && isAdmin(request.resource.data.siteId);
    }

    match /sites/{siteId} {
      allow read: if isMember(siteId) || isDevice(siteId);

      // A new place: the creator is its only administrator.
      allow create: if signedIn()
        && request.resource.data.owner == uid()
        && request.resource.data.members.keys().hasOnly([uid()])
        && request.resource.data.members[uid()] == 'admin';

      // Administrators change anything (except the owner).
      allow update: if isAdmin(siteId) && request.resource.data.owner == resource.data.owner
        // the owner can never be removed or demoted
        && request.resource.data.members.get(resource.data.owner, '') == 'admin';

      // The place's computer only reports its status (addresses, cameras, last contact).
      allow update: if isDevice(siteId) && onlyChanges(['server', 'cameras']);

      // Joining through an invite: adds only yourself, with the invite's role, in the same
      // operation that marks the invite as used by you.
      allow update: if signedIn()
        && onlyChanges(['members', 'memberInfo', 'lastInvite'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid()])
        && request.resource.data.memberInfo.diff(resource.data.memberInfo).affectedKeys().hasOnly([uid()])
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.lastInvite)).data.usedBy == uid()
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.lastInvite)).data.siteId == siteId
        && request.resource.data.members[uid()] == getAfter(/databases/$(database)/documents/invites/$(request.resource.data.lastInvite)).data.role;

      // Leaving a place yourself.
      allow update: if signedIn() && uid() != resource.data.owner
        && onlyChanges(['members', 'memberInfo'])
        && !(uid() in request.resource.data.members)
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid()]);

      allow delete: if signedIn() && resource.data.owner == uid();

      match /events/{eventId} {
        allow read: if isMember(siteId);
        allow create: if isDevice(siteId);
        allow delete: if isAdmin(siteId);
      }
    }

    match /invites/{code} {
      // Anyone signed in with the link can see who invited them and to which place.
      allow get: if signedIn();
      allow create: if isAdmin(request.resource.data.siteId)
        && request.resource.data.by == uid()
        && request.resource.data.usedBy == null
        && request.resource.data.role in ['admin', 'viewer']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(49, 'h');
      // Accept: one person, before it expires.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.time < resource.data.expiresAt
        && onlyChanges(['usedBy', 'usedAt'])
        && request.resource.data.usedBy == uid();
      allow delete: if isAdmin(resource.data.siteId);
    }

    match /pairings/{code} {
      // A new computer signs in (anonymous account) and shows a code on its screen.
      allow create: if signedIn() && request.resource.data.deviceUid == uid() && request.resource.data.siteId == null;
      allow get: if signedIn();
      // An administrator confirms: links the computer to their place.
      allow update: if resource.data.siteId == null && onlyChanges(['siteId', 'siteName', 'by'])
        && isAdmin(request.resource.data.siteId) && request.resource.data.by == uid();
      allow delete: if signedIn() && resource.data.deviceUid == uid();
    }
  }
}
